From 8a2a6aed94bf7c55b8ec43f3dc934083ebe47263 Mon Sep 17 00:00:00 2001
From: Jyjyc <35625443+Jyjyc@users.noreply.github.com>
Date: Mon, 17 Nov 2025 18:50:53 +0100
Subject: [PATCH 003/119] Create kernel.yaml

---
 .github/workflows/kernel.yaml | 170 ++++++++++++++++++++++++++++++++++
 1 file changed, 170 insertions(+)
 create mode 100644 .github/workflows/kernel.yaml

diff --git a/.github/workflows/kernel.yaml b/.github/workflows/kernel.yaml
new file mode 100644
index 000000000000..4912aa807d8e
--- /dev/null
+++ b/.github/workflows/kernel.yaml
@@ -0,0 +1,170 @@
+name: Build Android Kernel (moonstone)
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [ jyjyc-mods ]
+
+jobs:
+  build:
+    runs-on: ubuntu-24.04
+
+    steps:
+    - name: Maximize Build Space
+      uses: AdityaGarg8/remove-unwanted-software@v5
+      with:
+        remove-dotnet: 'true'          # Frees ~2 GB
+        remove-android: 'true'         # Frees ~9 GB
+        remove-haskell: 'true'         # Frees ~5.2 GB
+        remove-codeql: 'true'          # Frees ~5.4 GB
+        remove-docker-images: 'true'   # Frees ~3.2 GB
+        remove-large-packages: 'true'  # Frees ~3.1 GB
+        remove-swapfile: 'false'        # Frees ~4 GB
+        remove-cached-tools: 'false'   # Avoid unless confirmed safe
+        verbose: 'true'                # Enable detailed logging
+ 
+    - name: Checkout
+      uses: actions/checkout@v4
+      with:
+        submodules: recursive
+
+    - name: Install deps
+      run: |
+        sudo apt update
+        sudo apt remove -y firefox
+        sudo apt upgrade -y
+        sudo apt install -y bc bison flex libssl-dev build-essential \
+        ccache libncurses5-dev libncursesw5-dev python3 zstd repo git \
+        git-lfs device-tree-compiler lz4 xz-utils fontconfig lib32z1-dev \
+        zlib1g-dev python-is-python3 p7zip-full android-sdk-libsparse-utils \
+        erofs-utils default-jdk gnupg gperf zip curl libncurses-dev libx11-dev \
+        libreadline-dev libgl1 libgl1-mesa-dev make sudo bc grep tofrodos \
+        python3-markdown libxml2-utils xsltproc libc6-dev libtinfo6 cpio kmod \
+        openssl libelf-dev pahole libarchive-tools rsync ssh git-core \
+        x11proto-core-dev unzip \
+        lld-20 clang-tools-20 llvm-20-dev bolt-20 libpolly-20-dev \
+        --fix-missing
+
+    - name: Configure ccache
+      continue-on-error: true
+      run: |
+        mkdir -p ~/.ccache
+        export CCACHE_DIR="~/.ccache"
+        echo "CCACHE_DIR=$CCACHE_DIR" >> $GITHUB_ENV
+        export PATH="/usr/lib/ccache:/usr/local/opt/ccache/libexec:$PATH"
+        echo "PATH=$PATH" >> $GITHUB_ENV
+        echo "max_size = 8G" >> ~/.ccache/ccache.conf
+        echo "compression = true" >> ~/.ccache/ccache.conf
+        echo "hash_dir = false" >> ~/.ccache/ccache.conf
+        echo "sloppiness = file_stat_matches,include_file_mtime,include_file_ctime,time_macros" >> ~/.ccache/ccache.conf
+
+    - name: Cache compilation
+      continue-on-error: true
+      if: always()
+      uses: actions/cache@v4.3.0
+      with:
+        path: ~/.ccache
+        key: ccache-${{ runner.os }}-${{ github.run_id }}
+        restore-keys: |
+          ccache-${{ runner.os }}-
+        save-always: true
+
+    - name: Patch
+      continue-on-error: true
+      run: |
+        KERNEL_ROOT=$(pwd)
+        echo "KERNEL_ROOT: $KERNEL_ROOT"
+        echo "Setup SukiSU"
+        curl -LSs "https://raw.githubusercontent.com/SukiSU-Ultra/SukiSU-Ultra/main/kernel/setup.sh" | bash -s susfs-main
+        echo "Get susfs"
+        #git clone --branch kernel-5.4-jyc-test-1 --single-branch https://github.com/Jyjyc/susfs4ksu.git susfs
+        git clone --branch gki-android12-5.10 --single-branch https://gitlab.com/simonpunk/susfs4ksu.git susfs
+        cd susfs/kernel_patches
+        echo "Get TWA_RESUME patch"
+        #curl -LSs -o ./KernelSU/twa_resume.patch "https://raw.githubusercontent.com/Jyjyc/susfs4ksu/refs/heads/kernel-5.4-jyc-test-1/kernel_patches/KernelSU/twa_resume.patch"
+        curl -LSs -o ./KernelSU/twa_resume.patch "https://raw.githubusercontent.com/Jyjyc/susfs4ksu/8135e9b93719606732977e56817dc6006be44f7e/kernel_patches/KernelSU/twa_resume.patch"
+        echo "Copy patches"
+        cp ./KernelSU/twa_resume.patch $KERNEL_ROOT/KernelSU/twa_resume.patch
+        #cat ./KernelSU/10_enable_susfs_for_ksu/10_enable_susfs_for_ksu_00*.patch > $KERNEL_ROOT/KernelSU/10_enable_susfs_for_ksu.patch
+        #cat ./50_add_susfs_in_kernel-5.4/50_add_susfs_in_kernel-5.4_00*.patch > $KERNEL_ROOT/50_add_susfs_in_kernel.patch 
+        cp ./fs/* $KERNEL_ROOT/fs/
+        cp ./include/linux/* $KERNEL_ROOT/include/linux/
+        #echo "Apply susfs patches"
+        #patch -p1 -F5 < 10_enable_susfs_for_ksu.patch
+        cd $KERNEL_ROOT
+        #patch -p1 -F5 < 50_add_susfs_in_kernel.patch
+        echo "Apply custom patches"
+        cat ./patch/*.patch > $KERNEL_ROOT/custom.patch
+        patch -p1 -F5 < $KERNEL_ROOT/custom.patch
+        cd $KERNEL_ROOT/KernelSU
+        echo "Apply TWA_RESUME patch"
+        #patch -p1 -F5 < twa_resume.patch
+
+    - name: Configure env
+      run: |
+        echo "ARCH=arm64" >> $GITHUB_ENV
+        echo "SUBARCH=arm64" >> $GITHUB_ENV
+        echo "CROSS_COMPILE=aarch64-none-linux-gnu-" >> $GITHUB_ENV
+        echo "CLANG_TRIPLE=aarch64-linux-gnu-" >> $GITHUB_ENV
+        echo "CC=ccache clang-20" >> $GITHUB_ENV
+        echo "CXX=ccache clang++-20" >> $GITHUB_ENV
+        echo "AR=llvm-ar-20" >> $GITHUB_ENV
+        echo "NM=llvm-nm-20" >> $GITHUB_ENV
+        echo "LD=ld.lld-20" >> $GITHUB_ENV
+        echo "STRIP=llvm-strip-20" >> $GITHUB_ENV
+        echo "OBJCOPY=llvm-objcopy-20" >> $GITHUB_ENV
+        echo "OBJDUMP=llvm-objdump-20" >> $GITHUB_ENV
+        echo "READELF=llvm-readelf-20" >> $GITHUB_ENV
+        echo "HOSTCC=ccache clang-20" >> $GITHUB_ENV
+        echo "HOSTCXX=ccache clang++-20" >> $GITHUB_ENV
+        echo "CFLAGS=\"-O3 -flto=thin\"" >> $GITHUB_ENV
+        echo "CXXFLAGS=\"-O3 -flto=thin\"" >> $GITHUB_ENV
+        echo "LDFLAGS=\"-flto=thin -fuse-ld=lld-20\"" >> $GITHUB_ENV
+        echo "LTO=thin" >> $GITHUB_ENV
+        echo "LLVM=1" >> $GITHUB_ENV
+        echo "LLVM_IAS=1" >> $GITHUB_ENV
+        echo "KBUILD_BUILD_USER=github" >> $GITHUB_ENV
+        echo "KBUILD_BUILD_HOST=actions" >> $GITHUB_ENV
+        echo "LLVM_ENABLE_PROJECTS=clang;polly;lld" >> $GITHUB_ENV
+        echo "LLVM_USE_LINKER=lld-20" >> $GITHUB_ENV
+
+    - name: Defconfig
+      run: |
+        make -j$(nproc) O=out stone_defconfig
+
+    - name: Apply local config tweaks (optional)
+      run: |
+        ./scripts/config --file out/.config \
+          --enable CONFIG_KALLSYMS_ALL \
+          --enable CONFIG_KPROBES \
+          --enable CONFIG_KRETPROBES \
+          --enable CONFIG_SUSFS4KSU 
+        make -j$(nproc) O=out olddefconfig
+  
+    - name: Collect .rej files
+#      if: always()
+      continue-on-error: true
+      run: |
+        mkdir -p rejects
+        find . -name "*.rej" | zip -@ rejects/rejects.zip
+
+    - name: Upload patch rejects
+#      if: always()
+      continue-on-error: true
+      uses: actions/upload-artifact@v4
+      with:
+        name: patch-rejects
+        path: rejects/
+
+    - name: Build kernel
+      run: |
+        make -j$(nproc) O=out
+
+    - name: Archive build artifacts
+      uses: actions/upload-artifact@v4
+      with:
+        name: kernel-out
+        path: |
+          out/arch/arm64/boot/Image*
+          out/arch/arm64/boot/dts/**/*.dtb
+          out/arch/arm64/boot/dtbo.img

